---
/*
 * Logo: brand-kit C2 emblem in its own colours + live Inter 800 wordmark (spec section 7).
 * On dark backgrounds the top diamond turns white.
 */
interface Props {
  size?: 'header' | 'footer';
  dark?: boolean;
}
const { size = 'header', dark = false } = Astro.props;
const dims = size === 'footer' ? { w: 34.7, h: 40 } : { w: 31.3, h: 36 };
---
<span class:list={['logo', `logo--${size}`, { 'logo--dark': dark }]}>
  <svg
    width={dims.w}
    height={dims.h}
    viewBox="21 6 178 205"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path class="logo__top" d="M 110 13 L 192 57 L 110 100 L 28 57 Z" stroke-width="13"></path>
    <path class="logo__mid" d="M 28 116 L 110 159 L 192 116" stroke-width="13"></path>
    <path class="logo__bottom" d="M 28 161 L 110 204 L 192 161" stroke-width="13"></path>
  </svg>
  <!-- the space keeps the text "IT ASSET LOGISTICS" (accessible name ⊇ visible text, WCAG 2.5.3);
       between flex items it takes no room -->
  <span class="logo__word"><span>IT ASSET</span> <span>LOGISTICS</span></span>
</span>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .logo--footer { gap: 11px; }
  .logo svg { flex: 0 0 auto; }
  .logo__top { stroke: var(--logo-top); }
  .logo__mid { stroke: var(--logo-mid); }
  .logo__bottom { stroke: var(--logo-bottom); }
  .logo--dark .logo__top { stroke: #FFFFFF; }
  .logo__word {
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--logo-top);
    white-space: nowrap;
  }
  .logo--footer .logo__word { font-size: 17.8px; }
  .logo--dark .logo__word { color: #FFFFFF; }
</style>
