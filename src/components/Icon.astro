---
/*
 * Line icons from the approved design (24×24 grid). Colour comes from CSS `color` (currentColor);
 * size and stroke width follow each place in the design.
 */
const ICONS = {
  arrow: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  receive: '<path d="M21 8v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8"/><path d="M2 8l2.5-5h15L22 8H2z"/>',
  register: '<path d="M4 7V5h3M20 7V5h-3M4 17v2h3M20 17v2h-3"/><path d="M8 9v6M11.5 9v6M15 9v6"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>',
  truck: '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18.5" r="1.7"/><circle cx="17" cy="18.5" r="1.7"/>',
  return: '<path d="M3 11a9 9 0 0115.5-6"/><path d="M21 13a9 9 0 01-15.5 6"/><path d="M18 3v5h-5"/><path d="M6 21v-5h5"/>',
  building: '<path d="M3 21V9l7-4 7 4"/><path d="M17 21V13h4v8"/><path d="M7 21v-5h4v5"/>',
  cube: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
  sliders: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
  laptop: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 2.5 15.4 0 18-2.5-2.6-2.5-15.4 0-18z"/>',
  pin: '<path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  spinner: '<path d="M12 3a9 9 0 109 9"/>',
  chart: '<path d="M4 20h16"/><path d="M7 16v-5M12 16V7M17 16v-8"/>',
  route: '<circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H15a3 3 0 000-6H9a3 3 0 010-6h6.5"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  prev: '<path d="M15 5l-7 7 7 7"/>',
  next: '<path d="M9 5l7 7-7 7"/>',
  play: '<path d="M7 4l13 8-13 8z" fill="currentColor"/>',
  pause: '<rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"/>',
  network: '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/>',
  gauge: '<path d="M4 18a9 9 0 1116 0"/><path d="M12 14l4-5"/><circle cx="12" cy="15" r="1.4"/>',
  display: '<path d="M3 4h18M5 4v11h14V4"/><path d="M12 15v3M8 21l4-3 4 3"/>',
  wrench: '<path d="M14 6a4 4 0 00-5 5l-6 6 3 3 6-6a4 4 0 005-5l-2.5 2.5-2.5-2.5L14 6z"/>',
  case: '<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V5h6v3"/><path d="M12 11v6M9 14h6"/>',
  clipboard: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v3h6V3"/><path d="M9 11h6M9 15h6"/>',
  download: '<path d="M12 4v11"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/>',
  bars: '<path d="M3 20h18"/><rect x="5" y="13" width="4" height="7"/><rect x="10" y="9" width="4" height="11"/><rect x="15" y="5" width="4" height="15"/>',
  calendar: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  document: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  hdd: '<rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="10" r="4"/><path d="M12 10h.01M8 18h3M16 18h.01"/>',
  ssd: '<rect x="3" y="6" width="18" height="12" rx="1.5"/><path d="M7 10h6M7 14h3"/><path d="M17 10v4"/>',
  usb: '<rect x="8" y="9" width="8" height="12" rx="1.5"/><path d="M10 9V4h4v5"/><path d="M11 6.5h.01M13 6.5h.01"/>',
  // not in the design: email/phone rows appear only once contacts are filled in (spec section 6)
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>',
  handover: '<circle cx="8" cy="8" r="3"/><path d="M3 20c0-3 2.4-5 5-5s5 2 5 5"/><path d="M15 12h6M18 9l3 3-3 3"/>',
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 16, stroke = 1.8, class: cls } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
