---
import Icon, { type IconName } from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import type { PageData } from '../../lib/content';

interface Props {
  block: PageData<'media'>['after_storage'];
}
const { block } = Astro.props;
const ICONS: IconName[] = ['return', 'handover', 'document'];
// the last option (destruction) is a separate service: dashed card, as in the design
const last = block.items.length - 1;
---
<section id="after-storage" class="sec sec--84 af">
  <div class="container">
    <SectionHead label={block.label} title={block.title} intro={block.intro} />
    <div class="af__grid">
      {block.items.map((item, i) => (
        <article class:list={['af__card', i === last && 'af__card--separate']}>
          <span class="af__icon"><Icon name={ICONS[i] ?? 'document'} size={20} stroke={1.7} /></span>
          <h3>{item.title}</h3>
          {item.paragraphs.map((p) => <p>{p}</p>)}
        </article>
      ))}
    </div>
    <p class="af__note">{block.note}</p>
  </div>
</section>

<style>
  .af { background: var(--surface); border-bottom: 1px solid var(--line); }
  .af__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .af__card {
    padding: 24px 24px 26px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .af__card--separate { border: 1px dashed var(--rail); background: transparent; }
  .af__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 14px;
    border-radius: 10px;
    background: var(--accent-tint);
    color: var(--accent);
  }
  .af__card--separate .af__icon {
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--text);
  }
  .af__card h3 {
    margin-bottom: 8px;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .af__card p { font-size: 14.5px; line-height: 1.6; color: var(--text); }
  .af__card p + p { margin-top: 8px; }
  .af__note {
    max-width: 820px;
    margin-top: 24px;
    padding-left: 16px;
    border-left: 3px solid var(--accent);
    font-size: 15.5px;
    line-height: 1.55;
    font-weight: 600;
    color: var(--ink);
  }
</style>
