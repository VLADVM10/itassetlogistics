---
/* Section heading row used on inner pages: eyebrow + H2 on the left, intro on the right. */
interface Props {
  label: string;
  title: string;
  intro?: string | string[];
  /** margin under the row: 40px in most sections, 36px above the Journey */
  gap?: 36 | 40;
}
const { label, title, intro, gap = 40 } = Astro.props;
const paragraphs = intro === undefined ? [] : Array.isArray(intro) ? intro : [intro];
---
<div class:list={['shead', gap === 36 && 'shead--36']}>
  <div class="shead__titles">
    <p class="eyebrow">{label}</p>
    <h2 class="h2 shead__title">{title}</h2>
  </div>
  {paragraphs.length === 1 && <p class="shead__intro">{paragraphs[0]}</p>}
  {paragraphs.length > 1 && (
    <div class="shead__intro shead__intro--many">{paragraphs.map((p) => <p>{p}</p>)}</div>
  )}
</div>

<style>
  .shead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 20px 56px;
    margin-bottom: 40px;
  }
  .shead--36 { margin-bottom: 36px; }
  .shead__titles { flex: 999 1 480px; min-width: 0; }
  .shead__title { max-width: 620px; }
  .shead__intro {
    flex: 1 1 340px;
    min-width: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text);
  }
  .shead__intro--many p { margin-bottom: 10px; }
</style>
