---
import type { PageData } from '../../lib/content';

interface Props {
  tag: PageData<'home'>['hero']['tag'];
}
const { tag } = Astro.props;

/*
 * Size of the tag (spec section 16, client decision): 'A' — full size, 'B' — 18% smaller.
 * Only the position over the illustration changes; content and layout stay the same.
 */
const VARIANT = 'A' as 'A' | 'B';

// Decorative barcode bars [x, width] and QR modules [x, y, w, h], copied from the design.
const BARS = [
  [0, 3], [5, 1.5], [9, 4], [15, 1.5], [19, 2.5], [24, 5], [31, 1.5], [35, 3], [41, 1.5], [45, 4],
  [52, 2], [57, 1.5], [61, 5], [68, 2], [73, 1.5], [77, 3], [83, 4], [90, 1.5], [94, 2.5], [99, 1.5],
  [103, 5], [110, 2], [115, 3], [121, 1.5], [125, 4], [132, 1.5], [136, 2.5], [141, 5], [148, 1.5],
  [152, 3], [158, 2], [163, 4], [170, 1.5], [174, 2.5], [179, 1.5], [183, 5], [191, 2], [196, 3],
  [202, 1.5], [206, 4], [213, 1.5], [217, 2.5], [222, 5], [229, 1.5], [233, 3], [239, 2], [244, 4],
  [251, 1.5], [255, 2.5], [260, 1.5], [264, 5], [272, 2], [277, 3], [283, 1.5], [287, 4], [294, 1.5],
  [297, 3],
];
const QR = [
  [8, 0, 1, 2], [10, 1, 2, 1], [9, 3, 1, 3], [11, 4, 2, 2], [8, 8, 2, 1], [11, 8, 1, 3], [13, 9, 2, 1],
  [16, 8, 1, 2], [18, 9, 3, 1], [0, 8, 2, 1], [3, 9, 1, 2], [5, 8, 2, 2], [1, 11, 3, 1], [8, 11, 2, 2],
  [13, 12, 1, 3], [15, 11, 2, 1], [18, 12, 2, 2], [8, 15, 1, 2], [10, 14, 2, 1], [9, 18, 3, 1],
  [12, 16, 1, 2], [14, 15, 2, 2], [17, 16, 1, 3], [19, 15, 2, 1], [15, 19, 2, 2], [19, 18, 1, 3],
];
const FINDERS = [[0, 0], [14, 0], [0, 14]];

// "Illustrative example. Not an actual customer record." — first sentence bold, the rest muted
const [noteHead, noteRest] = tag.note.split(/(?<=[.!?])\s+(.*)/s);

const fields = [
  { label: tag.device_label, value: tag.device },
  { label: tag.asset_label, value: tag.asset_id, mono: true },
  { label: tag.location_label, value: tag.location },
];
---
<div class:list={['tag', VARIANT === 'B' && 'tag--b']}>
  <div class="tag__head">
    <span class="tag__brand">
      <svg width="13" height="15" viewBox="21 6 178 205" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M 110 13 L 192 57 L 110 100 L 28 57 Z" stroke="#FFFFFF" stroke-width="13" />
        <path d="M 28 116 L 110 159 L 192 116" stroke="#AEB9C9" stroke-width="13" />
        <path d="M 28 161 L 110 204 L 192 161" stroke="#095BFF" stroke-width="13" />
      </svg>
      IT Asset Logistics
    </span>
    <span class="tag__title">{tag.title}</span>
  </div>

  <div class="tag__body">
    <p class="tag__key">{tag.serial_label}</p>
    <p class="tag__serial">{tag.serial}</p>
    <svg class="tag__barcode" width="100%" height="30" viewBox="0 0 300 40" preserveAspectRatio="none" aria-hidden="true">
      <g fill="#0D1B2A">{BARS.map(([x, w]) => <rect x={x} width={w} height="40" />)}</g>
    </svg>
    <dl class="tag__grid">
      {fields.map((f) => (
        <div>
          <dt class="tag__key">{f.label}</dt>
          <dd class="tag__value">{f.mono ? <span class="tag__mono">{f.value}</span> : f.value}</dd>
        </div>
      ))}
      <div>
        <dt class="tag__key">{tag.status_label}</dt>
        <dd class="tag__value"><span class="tag__status"><span aria-hidden="true"></span>{tag.status}</span></dd>
      </div>
    </dl>
  </div>

  <div class="tag__foot">
    <svg width="36" height="36" viewBox="0 0 21 21" aria-hidden="true" shape-rendering="crispEdges">
      <g fill="#0D1B2A">{FINDERS.map(([x, y]) => <rect x={x} y={y} width="7" height="7" />)}</g>
      <g fill="#F5F7FA">{FINDERS.map(([x, y]) => <rect x={x + 1} y={y + 1} width="5" height="5" />)}</g>
      <g fill="#0D1B2A">
        {FINDERS.map(([x, y]) => <rect x={x + 2} y={y + 2} width="3" height="3" />)}
        {QR.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
      </g>
    </svg>
    <p class="tag__note">{noteHead}{noteRest && <span>{noteRest}</span>}</p>
  </div>
</div>

<style>
  .tag {
    position: absolute;
    left: -26px;
    bottom: -30px;
    width: 272px;
    overflow: hidden;
    border: 1px solid var(--line-3);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 2px 4px rgba(13, 27, 42, 0.06), 0 30px 60px -22px rgba(13, 27, 42, 0.34);
    transform: rotate(-3deg);
  }
  .tag--b {
    left: -30px;
    bottom: -38px;
    transform: rotate(-3deg) scale(0.82);
    transform-origin: left bottom;
  }
  /* below 1181px the tag sits straight under the illustration */
  @media (max-width: 1180px) {
    .tag, .tag--b {
      position: static;
      width: 100%;
      max-width: 340px;
      margin-top: 12px;
      transform: none;
    }
  }

  .tag__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    background: var(--ink);
  }
  .tag__brand {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    white-space: nowrap;
  }
  .tag__brand svg { flex: 0 0 13px; }
  .tag__title {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dark-text);
    white-space: nowrap;
  }

  .tag__body { padding: 13px 14px 12px; }
  .tag__key {
    margin: 0 0 2px;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tag__serial {
    margin-bottom: 9px;
    font-family: var(--font-mono);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .tag__barcode { margin-bottom: 10px; }
  .tag__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 12px;
    margin: 0;
    padding-top: 11px;
    border-top: 1px dashed var(--line-3);
  }
  .tag__grid > div { min-width: 0; }
  .tag__value {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--ink);
  }
  .tag__mono { font-family: var(--font-mono); }
  .tag__status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 7px;
    border-radius: 999px;
    background: var(--pill);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .tag__status span {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tag__foot {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    background: var(--surface-2);
    border-top: 1px solid var(--line);
  }
  .tag__foot svg { flex: 0 0 36px; }
  .tag__note {
    min-width: 0;
    font-size: 11.5px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--ink);
  }
  .tag__note span {
    display: block;
    font-weight: 400;
    color: var(--muted);
  }
  /* phones: the tag is shown full width, so its smallest labels can be readable */
  @media (max-width: 560px) {
    .tag__title { font-size: 10px; }
    .tag__key { font-size: 10px; }
    .tag__status { font-size: 11px; }
    .tag__value { font-size: 13.5px; }
  }
</style>
