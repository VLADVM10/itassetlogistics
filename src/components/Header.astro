---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { pathFor, type Lang, type PageKey } from '../i18n/routes';
import { getSettings } from '../lib/content';

interface Props {
  lang: Lang;
  current: PageKey;
  alternates: Record<Lang, string>;
}
const { lang, current, alternates } = Astro.props;
const { nav } = await getSettings(lang);

// Media Storage is intentionally not in the main menu (spec section 4).
const links = [
  { key: 'hub', label: nav.hub.label, href: pathFor('hub', lang) },
  { key: 'managed', label: nav.managed.label, href: pathFor('managed', lang) },
] as const;
const contactHref = pathFor('contact', lang);
const isCurrent = (key: string) => (key === current ? 'page' : undefined);
---
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="site-header__logo" href={pathFor('home', lang)} aria-label={nav.logo_label}>
      <Logo />
    </a>

    <nav class="nav-d" aria-label={nav.aria_label}>
      {links.map((l) => (
        <a class="nav-d__link" href={l.href} aria-current={isCurrent(l.key)}>{l.label}</a>
      ))}
      <a class="btn btn-p nav-d__cta" href={contactHref} aria-current={isCurrent('contact')}>{nav.contact.label}</a>
      <LangSwitch lang={lang} alternates={alternates} label={nav.lang_switch} />
    </nav>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
      data-label-open={nav.menu_open}
      data-label-close={nav.menu_close}
      aria-label={nav.menu_open}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path class="burger__open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="burger__close" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="nav-m" aria-label={nav.aria_label} data-menu>
    <div class="container nav-m__inner">
      {links.map((l) => (
        <a class="nav-m__link" href={l.href} aria-current={isCurrent(l.key)}>{l.label}</a>
      ))}
      <a class="nav-m__link" href={contactHref} aria-current={isCurrent('contact')}>{nav.contact.label}</a>
      <span class="nav-m__lang"><LangSwitch lang={lang} alternates={alternates} label={nav.lang_switch} /></span>
    </div>
  </nav>
</header>

<script>
  import { initMenu } from '../scripts/menu';
  initMenu();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .site-header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }

  .nav-d {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-d__link {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .nav-d__link:hover { color: var(--accent); }
  .nav-d__link[aria-current='page'] { font-weight: 600; color: var(--ink); }
  .nav-d__cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }

  .burger {
    display: none;
    margin-left: auto;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-3);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .burger__close { display: none; }
  .burger[aria-expanded='true'] .burger__open { display: none; }
  .burger[aria-expanded='true'] .burger__close { display: inline; }

  .nav-m { display: none; }
  .nav-m__inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
    padding-bottom: 18px;
  }
  .nav-m__link {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-m__link:hover { color: var(--accent); }
  .nav-m__link[aria-current='page'] { font-weight: 600; }
  .nav-m__lang { padding-top: 6px; }

  @media (max-width: 900px) {
    .nav-d { display: none; }
    .nav-m {
      display: block;
      border-top: 1px solid var(--line);
      background: var(--surface);
    }
    /* With JS the menu is a toggle; without JS it simply stays open. */
    :global(html.js) .burger { display: flex; }
    :global(html.js) .nav-m:not(.is-open) { display: none; }
  }
</style>
