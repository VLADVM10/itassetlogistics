---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';
import { pathFor, type Lang } from '../i18n/routes';
import { z } from 'astro/zod';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const content = z
  .object({ title: z.string().min(1), text: z.string().min(1), home_link: z.string().min(1), contact_link: z.string().min(1) })
  .parse(await getPage('404', lang));
---
<Base lang={lang} page="404">
  <section class="sec nf">
    <div class="container nf__inner">
      <p class="label">404</p>
      <h1 class="h1">{content.title}</h1>
      <p class="lead">{content.text}</p>
      <div class="nf__actions">
        <a class="btn btn-p" href={pathFor('home', lang)}>{content.home_link}</a>
        <a class="btn btn-s" href={pathFor('contact', lang)}>{content.contact_link}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; }
  .nf__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .nf .lead { max-width: 620px; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
</style>
