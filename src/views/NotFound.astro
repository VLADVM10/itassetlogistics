---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';
import { pathFor, type Lang } from '../i18n/routes';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const content = await getPage('404', lang);
---
<Base lang={lang} page="404">
  <section class="sec nf">
    <div class="container nf__inner">
      <p class="label">404</p>
      <h1 class="h1 h1--page">{content.title}</h1>
      <p class="lead">{content.text}</p>
      <div class="nf__actions">
        <a class="btn btn-p" href={pathFor('home', lang)}>{content.home_link}</a>
        <a class="btn btn-s" href={pathFor('contact', lang)}>{content.contact_link}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* No artboard for 404: built from the Contact/Privacy page head (spec section 4) */
  .nf {
    min-height: 60vh;
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
    border-bottom: 1px solid var(--line);
  }
  .nf__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .nf .lead { max-width: 620px; font-size: 18px; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
</style>
