---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';
import { paragraphs } from '../lib/richtext';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage('privacy', lang);
// numbering is generated: editors only write section titles (spec section 6)
const sections = page.sections.map((s, i) => ({
  id: `pp-${i + 1}`,
  title: `${i + 1}. ${s.title}`,
  body: paragraphs(s.body),
}));
---
<Base lang={lang} page="privacy">
  <section class="sec pp-head">
    <div class="container">
      <h1 class="h1 h1--page pp-head__title">{page.h1}</h1>
      <p class="pp-head__intro">{page.intro}</p>
    </div>
  </section>

  <section class="pp">
    <div class="container pp__inner">
      <nav class="pp__toc" aria-label={page.toc_label}>
        <ol>
          {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        </ol>
      </nav>
      <article class="pp__body">
        {sections.map((s) => (
          <section id={s.id} class="pp__section">
            <h2>{s.title}</h2>
            {s.body.map((html) => <p set:html={html} />)}
          </section>
        ))}
      </article>
    </div>
  </section>
</Base>

<style>
  .pp-head {
    padding: 64px 0 40px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
    border-bottom: 1px solid var(--line);
  }
  .pp-head__title { margin-bottom: 16px; text-wrap: wrap; }
  .pp-head__intro {
    max-width: 720px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text);
  }
  @media (max-width: 760px) {
    .pp-head { padding: var(--section-y) 0; }
  }

  .pp { padding: 32px 0 96px; background: var(--surface); }
  .pp__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px 72px;
  }
  .pp__toc {
    position: sticky;
    top: 100px;
    flex: 1 1 240px;
    min-width: 0;
    padding-top: 28px;
  }
  .pp__toc ol { margin: 0; padding: 0; list-style: none; }
  .pp__toc a {
    display: block;
    padding: 7px 0 7px 14px;
    border-left: 2px solid var(--line);
    font-size: 14px;
    line-height: 1.4;
    color: var(--text);
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .pp__toc { position: static; padding-top: 0; }
  }

  .pp__body { flex: 999 1 560px; min-width: 0; max-width: 760px; }
  .pp__section { padding: 28px 0 16px; border-top: 1px solid var(--line); }
  .pp__section h2 {
    margin-bottom: 14px;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .pp__section p {
    margin-bottom: 12px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }
  .pp__section p :global(strong) { font-weight: 600; color: var(--ink); }
</style>
