---
// Stage 1 placeholder: proves layout, routing and the language switch.
// Each page gets its real sections in stage 3.
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content';
import type { Lang, PAGES } from '../i18n/routes';

interface Props {
  lang: Lang;
  page: keyof typeof PAGES;
}
const { lang, page } = Astro.props;
const { nav } = await getSettings(lang);
---
<Base lang={lang} page={page}>
  <section class="sec stub">
    <div class="container">
      <p class="label">{lang === 'uk' ? 'Каркас · етап 1' : 'Skeleton · stage 1'}</p>
      <h1 class="h1">{nav[page].label}</h1>
    </div>
  </section>
</Base>

<style>
  .stub { min-height: 60vh; background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%); }
  .stub .label { margin-bottom: 16px; }
</style>
