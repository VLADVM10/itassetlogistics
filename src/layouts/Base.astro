---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';

import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContacts, getPage, getSettings } from '../lib/content';
import { GA_MEASUREMENT_ID, PREVIEW } from '../lib/env';
import CookieConsent from '../components/CookieConsent.astro';
import {
  LANGS,
  OG_LOCALE,
  SITE_URL,
  absoluteUrl,
  pathFor,
  type Lang,
  type PageKey,
} from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const { seo } = await getPage(page, lang);
const { nav } = await getSettings(lang);
const contacts = await getContacts();

const is404 = page === '404';
// URL of this page in every language: the language switch never falls back to Home.
const alternates = Object.fromEntries(
  LANGS.map((l) => [l, is404 ? pathFor('home', l) : pathFor(page, l)]),
) as Record<Lang, string>;
const canonical = absoluteUrl(alternates[lang]);

/** Shared social image (spec section 10): C2 logo, 1200×630. A page can set its own in seo.og_image. */
const OG_IMAGE = '/og-default.png';

/*
 * Content-Security-Policy (spec section 13). Delivered in a meta tag because Cityhost's nginx serves
 * the HTML itself, past .htaccess; frame-ancestors and the other headers come from Cloudflare
 * (see ops/cloudflare.md). The only inline script is the `js` class flag below, allowed by hash:
 * change the hash together with that line. Turnstile needs its script and iframe origin.
 */
// Google Analytics hosts are allowed only when analytics is on (GA_MEASUREMENT_ID in src/lib/env.ts).
const GA_SCRIPT = GA_MEASUREMENT_ID ? ' https://www.googletagmanager.com' : '';
const GA_CONNECT = GA_MEASUREMENT_ID
  ? ' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com'
  : '';
const CSP = [
  "default-src 'self'",
  `script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://challenges.cloudflare.com${GA_SCRIPT}`,
  "style-src 'self'",
  `img-src 'self' data:${GA_CONNECT}`,
  "font-src 'self'",
  `connect-src 'self'${GA_CONNECT}`,
  'frame-src https://challenges.cloudflare.com',
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');

/*
 * Structured data (schema.org JSON-LD), one graph per page: who runs the site, the site itself,
 * this page, its place in the site (breadcrumbs) and, on the service pages, the service.
 * Email and phone appear only once contacts.json has them. A street address and opening hours
 * (LocalBusiness) can be added the same way when the client publishes them.
 */
const ORG_ID = `${SITE_URL}/#organization`;
const SITE_ID = `${SITE_URL}/#website`;
const home = absoluteUrl(pathFor('home', lang));
const SERVICE_PAGES = ['hub', 'managed', 'media'] as const;
const isService = (SERVICE_PAGES as readonly string[]).includes(page);
const pageName = page === 'home' || is404 ? '' : nav[page as Exclude<PageKey, 'home' | '404'>].label;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: 'IT Asset Logistics',
    url: `${SITE_URL}/`,
    logo: { '@type': 'ImageObject', url: absoluteUrl('/icon-512.png'), width: 512, height: 512 },
    image: absoluteUrl(OG_IMAGE),
    address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
    areaServed: { '@type': 'Country', name: 'Ukraine' },
    ...(contacts.email ? { email: contacts.email } : {}),
    ...(contacts.phone ? { telephone: contacts.phone } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': SITE_ID,
    name: 'IT Asset Logistics',
    url: `${SITE_URL}/`,
    inLanguage: [...LANGS],
    publisher: { '@id': ORG_ID },
  },
  {
    '@type': page === 'contact' ? 'ContactPage' : 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: seo.title,
    ...(seo.description ? { description: seo.description } : {}),
    inLanguage: lang,
    isPartOf: { '@id': SITE_ID },
    about: { '@id': ORG_ID },
    ...(pageName ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
  },
];
if (pageName) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: nav.home.label, item: home },
      { '@type': 'ListItem', position: 2, name: pageName, item: canonical },
    ],
  });
}
if (isService) {
  graph.push({
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: pageName,
    ...(seo.description ? { description: seo.description } : {}),
    url: canonical,
    provider: { '@id': ORG_ID },
    areaServed: { '@type': 'Country', name: 'Ukraine' },
  });
}
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}

    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    {is404 ? (
      !PREVIEW && <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l])} />)}
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en)} />
      </>
    )}

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'uk' && <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* .json, not .webmanifest: Cityhost nginx sends no MIME type for .webmanifest */}
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IT Asset Logistics" />
    <meta property="og:title" content={seo.title} />
    {seo.description && <meta property="og:description" content={seo.description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={absoluteUrl(seo.og_image || OG_IMAGE)} />
    {!seo.og_image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content="IT Asset Logistics" />
    <meta name="twitter:card" content="summary_large_image" />

    {!is404 && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{nav.skip_link}</a>
    <Header lang={lang} current={page} alternates={alternates} />
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
