---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';

import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interCyrillic from '@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContacts, getPage, getSettings } from '../lib/content';
import { PREVIEW } from '../lib/env';
import {
  LANGS,
  OG_LOCALE,
  SITE_URL,
  absoluteUrl,
  pathFor,
  type Lang,
  type PageKey,
} from '../i18n/routes';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const { seo } = await getPage(page, lang);
const { nav } = await getSettings(lang);
const contacts = await getContacts();

const is404 = page === '404';
// URL of this page in every language: the language switch never falls back to Home.
const alternates = Object.fromEntries(
  LANGS.map((l) => [l, is404 ? pathFor('home', l) : pathFor(page, l)]),
) as Record<Lang, string>;
const canonical = absoluteUrl(alternates[lang]);

/** Shared social image (spec section 10): C2 logo, 1200×630. A page can set its own in seo.og_image. */
const OG_IMAGE = '/og-default.png';

/*
 * Content-Security-Policy (spec section 13). Delivered in a meta tag because Cityhost's nginx serves
 * the HTML itself, past .htaccess; frame-ancestors and the other headers come from Cloudflare
 * (see ops/cloudflare.md). The only inline script is the `js` class flag below, allowed by hash:
 * change the hash together with that line. Turnstile needs its script and iframe origin.
 */
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://challenges.cloudflare.com",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  'frame-src https://challenges.cloudflare.com',
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IT Asset Logistics',
  url: `${SITE_URL}/`,
  logo: absoluteUrl('/icon-512.png'),
  address: { '@type': 'PostalAddress', addressLocality: 'Kyiv', addressCountry: 'UA' },
  ...(contacts.email ? { email: contacts.email } : {}),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}

    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    {is404 ? (
      !PREVIEW && <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l])} />)}
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en)} />
      </>
    )}

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'uk' && <link rel="preload" href={interCyrillic} as="font" type="font/woff2" crossorigin />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IT Asset Logistics" />
    <meta property="og:title" content={seo.title} />
    {seo.description && <meta property="og:description" content={seo.description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={absoluteUrl(seo.og_image || OG_IMAGE)} />
    {!seo.og_image && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content="IT Asset Logistics" />
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{nav.skip_link}</a>
    <Header lang={lang} current={page} alternates={alternates} />
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
