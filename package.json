{
  "name": "itassetlogistics-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build:preview": "node -e \"process.env.SITE_PREVIEW='1';require('child_process').execSync('astro build',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "ultrahtml": "1.7.0"
  }
}
